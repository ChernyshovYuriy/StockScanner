[Unit]
Description=StockScanner News Watchlist -- seed fresh inbox candidates and send the immediate alert
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/dev/stock-scanner
ExecStart=/usr/bin/python3 /home/pi/dev/stock-scanner/news_watchlist_service.py --mode seed
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
