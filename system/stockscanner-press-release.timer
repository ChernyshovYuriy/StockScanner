[Unit]
Description=Run StockScanner press-release tracker every 5 minutes, all day (news can break pre-market or after hours, so unlike the trading services this isn't restricted to market hours)

[Timer]
OnCalendar=*-*-* *:0/5
Persistent=false
Unit=stockscanner-press-release.service

[Install]
WantedBy=timers.target
