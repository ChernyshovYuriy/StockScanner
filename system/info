/etc/systemd/system/

sudo systemctl daemon-reload
sudo systemctl enable --now stockscanner-main.timer
sudo systemctl enable --now stockscanner-buy.timer
sudo systemctl enable --now stockscanner-monitor.timer
sudo systemctl enable --now stockscanner-dashboard.service

# Momentum sleeve — separate DB/capital, see config.py MOMENTUM_*
sudo systemctl enable --now stockscanner-momentum-pipeline.timer
sudo systemctl enable --now stockscanner-momentum-buy.timer
sudo systemctl enable --now stockscanner-momentum-monitor.timer

# EDGAR collector — 4th service, US SEC filings, own DB (data/edgar.db)
sudo systemctl enable --now stockscanner-edgar.timer

# Demand-signals collector — 5th service, own DB (data/demand_signals.db),
# runs 22:00 (after edgar's 21:30) so its EDGAR-adapted signals see that
# day's insider_buys. FINRA_CLIENT_ID/SECRET in .env are optional — see
# README.md; the other two sources (EDGAR insider buys, options flow) work
# without them.
sudo systemctl enable --now stockscanner-demand-signals.timer

# Macro conviction sleeve — 6th, separate DB/capital, see config.py MACRO_*.
# Reads the core sleeve's own intents (read-only) instead of running its own
# screener — no macro-pipeline unit needed. FRED_API_KEY in .env is required
# for this sleeve to ever buy or force-liquidate on regime; without it
# macro_regime.py returns a neutral no-op reading and the sleeve stays in
# cash indefinitely.
sudo systemctl enable --now stockscanner-macro-buy.timer
sudo systemctl enable --now stockscanner-macro-monitor.timer

systemctl list-timers --all | grep stockscanner

sudo systemctl start stockscanner-main.service
sudo systemctl start stockscanner-buy.service
sudo systemctl start stockscanner-monitor.service
sudo systemctl start stockscanner-momentum-pipeline.service
sudo systemctl start stockscanner-momentum-buy.service
sudo systemctl start stockscanner-momentum-monitor.service
sudo systemctl start stockscanner-edgar.service
sudo systemctl start stockscanner-demand-signals.service
sudo systemctl start stockscanner-macro-buy.service
sudo systemctl start stockscanner-macro-monitor.service

journalctl -u stockscanner-main.service -n 100 --no-pager
journalctl -u stockscanner-buy.service -n 100 --no-pager
journalctl -u stockscanner-monitor.service -n 100 --no-pager
journalctl -u stockscanner-dashboard.service -n 100 --no-pager
journalctl -u stockscanner-momentum-pipeline.service -n 100 --no-pager
journalctl -u stockscanner-momentum-buy.service -n 100 --no-pager
journalctl -u stockscanner-momentum-monitor.service -n 100 --no-pager
journalctl -u stockscanner-edgar.service -n 100 --no-pager
journalctl -u stockscanner-demand-signals.service -n 100 --no-pager
journalctl -u stockscanner-macro-buy.service -n 100 --no-pager
journalctl -u stockscanner-macro-monitor.service -n 100 --no-pager

# After changing stockscanner-edgar.timer's OnCalendar (e.g. the 2026-09
# 18:30 -> 21:30 fix), daemon-reload alone won't recompute an already-armed
# timer's next fire — restart it explicitly:
sudo systemctl restart stockscanner-edgar.timer
# Triple Screen tracker — 7th service, daily paper price-tracking experiment
# built on research/triple_screen (see triple_screen_tracker/__init__.py and
# config.py TRIPLE_SCREEN_TRACKER_*). Own SQLite DB, no capital/share sizing.
# Runs at 17:00, after main.py's 16:30 pipeline and position_monitor.py's
# 15:50 run — no file/DB collision, own DB.
sudo systemctl enable --now stockscanner-triple-screen-tracker.timer
sudo systemctl start stockscanner-triple-screen-tracker.service
journalctl -u stockscanner-triple-screen-tracker.service -n 100 --no-pager
