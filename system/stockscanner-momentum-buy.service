[Unit]
Description=StockScanner momentum sleeve virtual buy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/dev/stock-scanner
ExecStart=/usr/local/bin/python3.12 /home/pi/dev/stock-scanner/momentum_buy.py
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
