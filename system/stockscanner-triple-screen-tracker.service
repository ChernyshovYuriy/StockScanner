[Unit]
Description=StockScanner Triple Screen tracker (daily paper price-tracking experiment)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/dev/stock-scanner
ExecStart=/usr/bin/python3 /home/pi/dev/stock-scanner/triple_screen_tracker_service.py
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
