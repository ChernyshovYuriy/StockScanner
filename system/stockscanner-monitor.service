[Unit]
Description=StockScanner position monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/dev/stock-scanner
ExecStart=/usr/bin/python3 /home/pi/dev/stock-scanner/position_monitor.py
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target